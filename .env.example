# Option Calc API base URL. Keep the default path to use the Vite MOEX proxy,
# or point it to the standalone Rust backend, for example http://127.0.0.1:3000.
VITE_OPTION_CALC_BASE_URL=/moex-option-calc

# Optional dev-server proxy target for the standalone Rust backend. This avoids
# cross-origin browser requests while keeping VITE_OPTION_CALC_BASE_URL unchanged.
# VITE_OPTION_CALC_PROXY_TARGET=http://127.0.0.1:8080

# Interval for automatic portfolio and chart recalculation, in milliseconds.
VITE_AUTO_REFRESH_INTERVAL_MS=60000
