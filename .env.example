# Базовый адрес Option Calc API. Значение по умолчанию использует Vite-прокси MOEX.
# Для прямого подключения к Rust-бэкенду укажите, например, http://127.0.0.1:8080.
VITE_OPTION_CALC_BASE_URL=/moex-option-calc

# Необязательный адрес Rust-бэкенда для Vite-прокси. Браузер продолжит отправлять
# запросы на адрес фронтенда; VITE_OPTION_CALC_BASE_URL менять не потребуется.
# VITE_OPTION_CALC_PROXY_TARGET=http://127.0.0.1:8080

# Контракт API: rust либо moex. Без этого параметра определяется по адресу прокси.
# При прямом подключении без Vite-прокси задайте значение явно.
# VITE_OPTION_CALC_BACKEND=rust

# Интервал автоматического пересчёта портфеля и графиков в миллисекундах.
VITE_AUTO_REFRESH_INTERVAL_MS=60000
