{
  "name": "moex-options-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e:moex && npm run test:e2e:rust",
    "test:e2e:moex": "E2E_BACKEND=moex playwright test",
    "test:e2e:rust": "E2E_BACKEND=rust playwright test",
    "test:e2e:core:moex": "E2E_BACKEND=moex playwright test --grep-invert @catalog",
    "test:e2e:core:rust": "E2E_BACKEND=rust playwright test --grep-invert @catalog",
    "test:e2e:catalog:moex": "E2E_BACKEND=moex playwright test --grep @catalog",
    "test:e2e:catalog:rust": "E2E_BACKEND=rust playwright test --grep @catalog",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@lucide/vue": "1.46.0",
    "echarts": "6.1.0",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-echarts": "8.3.0",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "24.0.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.8.1",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.6.2",
    "jsdom": "28.1.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.2.5"
  }
}
